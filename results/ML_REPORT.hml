<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Stage 1 ML Training Report & Files Registry</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --bg-base: #0a0f1d;
            --bg-card: #121a2f;
            --border: rgba(255, 255, 255, 0.08);
            --primary: #6366f1;
            --primary-glow: rgba(99, 102, 241, 0.4);
            --emerald: #10b981;
            --sky: #38bdf8;
            --amber: #f59e0b;
            --rose: #f43f5e;
            --text: #f8fafc;
            --text-muted: #94a3b8;
            --text-dim: #64748b;
            --font-main: 'Inter', sans-serif;
            --font-heading: 'Outfit', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--bg-base);
            background-image: radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.12) 0px, transparent 50%),
                              radial-gradient(at 100% 100%, rgba(56, 189, 248, 0.08) 0px, transparent 50%);
            color: var(--text);
            font-family: var(--font-main);
            line-height: 1.6;
            padding: 32px;
        }
        .report-wrap {
            max-width: 1400px;
            margin: 0 auto;
        }
        .hero-header {
            background: linear-gradient(135deg, rgba(30, 27, 75, 0.8), rgba(15, 23, 42, 0.95));
            border: 1px solid rgba(99, 102, 241, 0.3);
            border-radius: 16px;
            padding: 32px;
            margin-bottom: 28px;
            box-shadow: 0 12px 36px rgba(0,0,0,0.4);
        }
        .hero-title {
            font-family: var(--font-heading);
            font-size: 26px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .badge-ver {
            font-size: 11px;
            background: rgba(99, 102, 241, 0.2);
            color: #a5b4fc;
            padding: 3px 10px;
            border-radius: 20px;
            border: 1px solid rgba(99, 102, 241, 0.4);
        }
        .hero-sub {
            color: var(--text-muted);
            font-size: 13px;
            margin-top: 6px;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin-top: 24px;
        }
        .kpi-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 16px;
            display: flex;
            flex-direction: column;
        }
        .kpi-lbl { font-size: 11px; color: var(--text-dim); text-transform: uppercase; font-weight: 700; }
        .kpi-num { font-family: var(--font-heading); font-size: 24px; font-weight: 800; margin: 4px 0; color: #fff; }
        .kpi-sub { font-size: 11px; color: var(--text-muted); }

        .section-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 24px;
            margin-bottom: 24px;
        }
        .section-title {
            font-family: var(--font-heading);
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-title i { color: var(--sky); }

        /* Class Distribution */
        .class-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 14px;
        }
        .class-bar-item {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 12px 14px;
        }
        .class-bar-header {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            margin-bottom: 6px;
        }
        .bar-track {
            width: 100%;
            height: 6px;
            background: rgba(255, 255, 255, 0.08);
            border-radius: 3px;
            overflow: hidden;
        }
        .bar-fill {
            height: 100%;
            background: linear-gradient(90deg, #6366f1, #38bdf8);
        }

        /* Table */
        .table-wrap {
            overflow-x: auto;
            margin-top: 12px;
        }
        .files-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
        }
        .files-table th, .files-table td {
            padding: 12px 14px;
            text-align: left;
            border-bottom: 1px solid var(--border);
        }
        .files-table th {
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-dim);
            font-size: 10.5px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .files-table tr:hover td {
            background: rgba(255, 255, 255, 0.02);
        }
        .cell-id { color: var(--text-dim); width: 40px; }
        .cell-name strong { color: #fff; }
        .badge-user {
            font-size: 11px;
            background: rgba(56, 189, 248, 0.15);
            color: #38bdf8;
            padding: 2px 8px;
            border-radius: 12px;
        }
        .badge-class {
            font-size: 11px;
            background: rgba(168, 85, 247, 0.15);
            color: #c084fc;
            padding: 2px 8px;
            border-radius: 6px;
            font-weight: 600;
        }
        .badge-barcode {
            display: inline-block;
            font-size: 10px;
            font-family: var(--font-mono);
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
            border: 1px solid rgba(16, 185, 129, 0.3);
            padding: 2px 6px;
            border-radius: 4px;
            margin: 2px 4px 2px 0;
        }
        .badge-none { font-size: 10px; color: var(--text-dim); }
        .badge-status {
            font-size: 11px;
            padding: 3px 8px;
            border-radius: 12px;
            font-weight: 600;
        }
        .status-match {
            background: rgba(16, 185, 129, 0.15);
            color: #34d399;
        }
        .status-diff {
            background: rgba(245, 158, 11, 0.15);
            color: #fbbf24;
        }
        .text-dim { color: var(--text-dim); font-size: 11px; }
        .footer {
            text-align: center;
            font-size: 12px;
            color: var(--text-dim);
            margin-top: 32px;
            border-top: 1px solid var(--border);
            padding-top: 20px;
        }
    </style>
</head>
<body>
    <div class="report-wrap">
        <!-- Hero Header -->
        <div class="hero-header">
            <div class="hero-title">
                <i class="fa-solid fa-brain-circuit" style="color: #818cf8;"></i>
                <span>Stage 1 ML OCR Training Report</span>
                <span class="badge-ver">v2.1.0 CONVERGED</span>
            </div>
            <p class="hero-sub">
                Generated dynamically on <strong>2026-08-26 12:15:38 UTC</strong> &bull; Output Directory: <code>./output/model/</code>
            </p>

            <div class="kpi-grid">
                <div class="kpi-card">
                    <span class="kpi-lbl">Model Accuracy</span>
                    <span class="kpi-num" style="color: #34d399;">100.0%</span>
                    <span class="kpi-sub">F1 Macro: 100.0%</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-lbl">Total Documents Used</span>
                    <span class="kpi-num">30</span>
                    <span class="kpi-sub">PDFs + Images Corpus</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-lbl">Multi-Tenant Users</span>
                    <span class="kpi-num" style="color: #38bdf8;">6</span>
                    <span class="kpi-sub">Distinct +user_email subfolders</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-lbl">Barcodes & QRs Detected</span>
                    <span class="kpi-num" style="color: #c084fc;">89</span>
                    <span class="kpi-sub">Header, Footer & Line Items</span>
                </div>
                <div class="kpi-card">
                    <span class="kpi-lbl">Training Duration</span>
                    <span class="kpi-num">10.821s</span>
                    <span class="kpi-sub">Feature extraction + Fit</span>
                </div>
            </div>
        </div>

        <!-- Class Distribution Section -->
        <div class="section-card">
            <div class="section-title">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Document Categories & Class Representation</span>
            </div>
            <div class="class-grid">
                
        <div class="class-bar-item">
            <div class="class-bar-header">
                <span>COMMERCIAL_INVOICE</span>
                <strong>8 docs (26.7%)</strong>
            </div>
            <div class="bar-track">
                <div class="bar-fill" style="width: 26.7%;"></div>
            </div>
        </div>
        

        <div class="class-bar-item">
            <div class="class-bar-header">
                <span>MEDICAL_PHARMA_INVOICE</span>
                <strong>19 docs (63.3%)</strong>
            </div>
            <div class="bar-track">
                <div class="bar-fill" style="width: 63.3%;"></div>
            </div>
        </div>
        

        <div class="class-bar-item">
            <div class="class-bar-header">
                <span>PURCHASE_RECEIPT</span>
                <strong>2 docs (6.7%)</strong>
            </div>
            <div class="bar-track">
                <div class="bar-fill" style="width: 6.7%;"></div>
            </div>
        </div>
        

        <div class="class-bar-item">
            <div class="class-bar-header">
                <span>TAX_STATEMENT</span>
                <strong>1 docs (3.3%)</strong>
            </div>
            <div class="bar-track">
                <div class="bar-fill" style="width: 3.3%;"></div>
            </div>
        </div>
        
            </div>
        </div>

        <!-- Files Used in the Process Registry -->
        <div class="section-card">
            <div class="section-title">
                <i class="fa-solid fa-folder-open"></i>
                <span>Files Used Inside the Learning Process (30 Files)</span>
            </div>
            <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 12px;">
                Complete inventory of all PDFs and images ingested from <code>./dataset_for_ml</code> and multi-tenant <code>+user_email</code> folders during this training run.
            </p>

            <div class="table-wrap">
                <table class="files-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Document File & Path</th>
                            <th>Source Tenant</th>
                            <th>Size</th>
                            <th>Extracted Content</th>
                            <th>Detected Barcodes / QR Codes</th>
                            <th>Ground Truth</th>
                            <th>Model Prediction</th>
                        </tr>
                    </thead>
                    <tbody>
                        
        <tr>
            <td class="cell-id">1</td>
