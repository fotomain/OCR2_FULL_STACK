#!/bin/bash
set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

# Free port 8000 if occupied
free_port() {
    local port=$1
    local pids=$(lsof -ti :"$port" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        echo "🛑 Stopping existing process on port $port (PID: $pids)..."
        kill -9 $pids 2>/dev/null || true
        sleep 0.5
    fi
}
free_port 8000

if [ -f "$DIR/.venv/bin/uvicorn" ]; then
    UVICORN_EXEC="$DIR/.venv/bin/uvicorn"
elif [ -f "$DIR/stage1_ml_ocr/.venv/bin/uvicorn" ]; then
    UVICORN_EXEC="$DIR/stage1_ml_ocr/.venv/bin/uvicorn"
else
    UVICORN_EXEC="uvicorn"
fi

export PYTHONPATH="$DIR:$DIR/stage1_ml_ocr:$PYTHONPATH"

echo "======================================================================="
echo " 🚀 Launching Stage 1: ML OCR FastAPI Backend Service"
echo " 📍 Server: http://127.0.0.1:8000"
echo " 📖 Swagger API Docs: http://127.0.0.1:8000/docs"
echo "======================================================================="

exec "$UVICORN_EXEC" stage1_ml_ocr.app.main:app --host 0.0.0.0 --port 8000 --reload
