#!/bin/bash
set -e

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$DIR"

# Free port 8080 if occupied
free_port() {
    local port=$1
    local pids=$(lsof -ti :"$port" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        echo "🛑 Stopping existing process on port $port (PID: $pids)..."
        kill -9 $pids 2>/dev/null || true
        sleep 0.5
    fi
}
free_port 8080

# 1. Check if Stage 1 FastAPI is running on port 8000; if not, launch it
if ! curl -s http://127.0.0.1:8000/health > /dev/null 2>&1; then
    echo "⚡ Stage 1 ML OCR is not running. Starting Stage 1 FastAPI on http://127.0.0.1:8000..."
    "$DIR/run_stage1_ml_ocr" &
    STAGE1_PID=$!
    for i in {1..15}; do
        if curl -s http://127.0.0.1:8000/health > /dev/null 2>&1; then
            echo "✅ Stage 1 ML OCR is ONLINE (PID: $STAGE1_PID)"
            break
        fi
        sleep 1
    done
else
    echo "✅ Stage 1 ML OCR is already running on http://127.0.0.1:8000"
fi

if [ -f "$DIR/.venv/bin/python" ]; then
    PYTHON_EXEC="$DIR/.venv/bin/python"
elif [ -f "$DIR/stage2_frontend_web/.venv/bin/python" ]; then
    PYTHON_EXEC="$DIR/stage2_frontend_web/.venv/bin/python"
else
    PYTHON_EXEC="python3"
fi

export PYTHONPATH="$DIR/stage2_frontend_web:$DIR:$PYTHONPATH"

echo "======================================================================="
echo " 🚀 Launching Stage 2: Django Web Frontend Dashboard"
echo " 📍 Web Dashboard: http://127.0.0.1:8080"
echo " 🔗 Backend API: http://127.0.0.1:8000"
echo "======================================================================="

# Run migrations
"$PYTHON_EXEC" stage2_frontend_web/manage.py migrate --noinput

exec "$PYTHON_EXEC" stage2_frontend_web/manage.py runserver 0.0.0.0:8080
